; data = swing

{vel} = sqrt({motX}^2 + {motY}^2 + {motZ}^2)
{dive} = 1 - if({motY} < 0, if({vel} >= 0.0001, (-{motY} / {vel})^1.5, 0), 0)
{differential} = ({yaw} - {bodyYaw}) / 180

{right_rotX} = -12'
{left_rotX} = {right_rotX}
{right_rotZ} = 90'(1 - {dive}) - 23'
{left_rotZ} = {right_rotZ}

{turn} = 10'sin(sqrt({data})2pi)
{right_rotY} = ((1 - 1) * 5 - 1 - 2{differential}) * 0.1 + {turn}
{left_rotY} = ((1 - 1) * 5 - 1 + 2{differential}) * 0.1 - {turn}

{right_flexY} = -19' + 51'{differential}
{left_flexY} = -19' - 51'{differential}
{right_flexZ} = 25'
{left_flexZ} = {right_flexZ}
