{data} = curve {data}
{bnce} = sin(pi{data})

{t1} = if({data} < 1, curve animate2({data}, 1, 0, 0.4, 0), 1)
{t2} = if({data} < 1, curve animate2({data}, 1, 0.2, 0.7, 0), 1)
{t3} = if({data} < 1, curve animate2({data}, 1, 0.4, 0.6, 0), 1)
{t4} = if({data} < 1, curve animate2({data}, 1, 0.5, 0.5, 0), 1)

{st1} = sin(pi{t1})
{st2} = sin(pi{t2})
{st3} = sin(pi{t3})
{st4} = sin(pi{t4})

;=============== CHIN ===============
{faceplateB_rotX} += 90'{data}
{faceplateB_posY} += 1{data} + 0.6{t4}
{faceplateB_posZ} += 2{data} + 1.5{t4}
{chinR1_rotY} -= 5'{t4}
{chinR1_posZ} -= 1.5{bnce}
{chinR2_rotX} -= 90'{data}
{chinR2_posY} -= max(({data} - 0.2) / 0.8, 0)
{chinR2_posZ} -= 0.2{data}
{chinR3_rotZ} -= 90'{t2}
{chinR3_posX} += 4{t2} - 1.5{st2}
{chinR3_posY} += 0.7{st2}

;=============== SIDES ===============
{helmetR7_posX} += 0.1{t2}
{helmetR7_posY} -= 1.9{t2}
{helmetR7_posZ} += 0.1{t2}
{helmetR8_rotY} += 90'{t2}
{helmetR8_posX} += 3{t2} - 0.8{st2}
{helmetR9_posX} -= 0.1{t1}
{helmetR9_posY} -= 1.5{t1}
{helmetR9_posZ} += 3{t1}
{helmetR5_rotZ} += 90'{t2} + 10'{bnce}
{helmetR5_posX} += 2{t3}
{helmetR5_posZ} += 2{t3}
{helmetR10_rotX} += 95'{t4} + 5'{st4} + 5'{st3}
{helmetR10_posY} -= 2{t4} - {st4}
{helmetR10_posZ} += 1.75{t4} + {st3} - {st4}
{helmetR11_rotZ} -= 90'{t2}
{helmetR11_posX} += 2.5{t4}
{helmetR12_rotY} += 90'{t2}
{helmetR12_posX} += 4{t3}
{helmetR12_posY} += 1.5{t3}

;=============== TOP ===============
{helmetR6_rotX} -= 87'{t1} - 20'{st4}
{helmetR6_posX} -= 0.1{t2}
{helmetR6_posY} -= {t2} + 0.7{st1}
{helmetR6_posZ} += 4{t2}

{helmetR4_rotX} -= 87'{t2}
{helmetR4_posX} += 0.3{t3}
{helmetR4_posY} += 5{t2} + 0.75{t4} - 1.2{st2} + 0.5{st3} - 2{st4}
{helmetR4_posZ} += 3{st2}

{helmetR3_rotX} += 20'{st3} - 20'{st4} + 5'{st3}
{helmetR3_posX} -=0.1{t3}
{helmetR3_posY} += 4.5{t3}
{helmetR2_rotX} -= 20'{t3} + 70'{t4} - 5'{st4}
{helmetR2_posY} += {t4} + 1.5{st4}
{helmetR2_posZ} -= 3{t4} - 1{st4} - {st3}

;=============== MIRRORING ===============
{chinL1_rotY} = -{chinR1_rotY}
{chinL1_posX} = -{chinR1_posX}
{chinL1_posZ} = {chinR1_posZ}
{chinL2_rotX} = {chinR2_rotX}
{chinL2_posY} = {chinR2_posY}
{chinL2_posZ} = {chinR2_posZ}
{chinL3_rotZ} = -{chinR3_rotZ}
{chinL3_posX} = -{chinR3_posX}
{chinL3_posY} = {chinR3_posY}
{helmetL7_posX} = -{helmetR7_posX}
{helmetL7_posY} = {helmetR7_posY}
{helmetL7_posZ} = {helmetR7_posZ}
{helmetL8_rotY} = -{helmetR8_rotY}
{helmetL8_posX} = -{helmetR8_posX}
{helmetL9_posX} = -{helmetR9_posX}
{helmetL9_posY} = {helmetR9_posY}
{helmetL9_posZ} = {helmetR9_posZ}
{helmetL5_rotZ} = -{helmetR5_rotZ}
{helmetL5_posX} = -{helmetR5_posX}
{helmetL5_posZ} = {helmetR5_posZ}
{helmetL10_rotX} = {helmetR10_rotX}
{helmetL10_posY} = {helmetR10_posY}
{helmetL10_posZ} = {helmetR10_posZ}
{helmetL11_rotZ} = -{helmetR11_rotZ}
{helmetL11_posX} = -{helmetR11_posX}
{helmetL12_rotY} = -{helmetR12_rotY}
{helmetL12_posX} = -{helmetR12_posX}
{helmetL12_posY} = {helmetR12_posY}
{helmetL6_rotX} = {helmetR6_rotX}
{helmetL6_posX} = -{helmetR6_posX}
{helmetL6_posY} = {helmetR6_posY}
{helmetL6_posZ} = {helmetR6_posZ}
{helmetL4_rotX} = {helmetR4_rotX}
{helmetL4_posX} = -{helmetR4_posX}
{helmetL4_posY} = {helmetR4_posY}
{helmetL4_posZ} = {helmetR4_posZ}
{helmetL3_rotX} = {helmetR3_rotX}
{helmetL3_posX} = -{helmetR3_posX}
{helmetL3_posY} = {helmetR3_posY}
{helmetL2_rotX} = {helmetR2_rotX}
{helmetL2_posY} = {helmetR2_posY}
{helmetL2_posZ} = {helmetR2_posZ}

;=============== LAYER 2 ===============
{faceplateB_L2_rotX} = {faceplateB_rotX}
{faceplateB_L2_posY} = {faceplateB_posY}
{faceplateB_L2_posZ} = {faceplateB_posZ}
