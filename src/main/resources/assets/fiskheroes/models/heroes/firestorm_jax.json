{
  "parent": "fiskheroes:hero_basic",
  "resources": {
    "layer1": "fiskheroes:firestorm_jax_layer1",
    "layer2": "fiskheroes:firestorm_jax_layer2",
    "lights": "fiskheroes:firestorm_jax_lights",
    "eyes": "fiskheroes:eyes_white"
  },
  "lights": {
    "renderLayer": {
      "CHESTPLATE": "lights"
    },
    "default": "null"
  },
  "custom": {
    "fiskheroes:overlay": {
      "applicable": ["CHESTPLATE"],
      "texture": "eyes",
      "opacity": 1.0,
      "data": 1.0,
      "conditionals": ["vars:FULL_SUIT"]
    },
    "fiskheroes:flames": {
      "applicable": ["CHESTPLATE"],
      "requiresFullSuit": true,
      "scaleRatio": 0.95,
      "opacity": 0.7
    },
    "fiskheroes:particles": {
      "particleType": "fiskheroes:firestorm",
      "conditionals": ["vars:FLYING"]
    }
  },
  "vars": {
    "FULL_SUIT": "entity.isWearingFullSuit()",
    "FLYING": "entity.getData('fiskheroes:jetpacking')"
  }
}
