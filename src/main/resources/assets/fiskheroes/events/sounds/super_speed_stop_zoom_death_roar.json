{
  "parent": "fiskheroes:sound_base",
  "sound": "fiskheroes:modifier.superspeed.stop.zoom.death.roar",
  "condition": {
    "start": "!entity.isInWater() && !entity.getData('fiskheroes:speeding') && Math.random() < 0.5"
  },
  "volume": "Math.min(0.0 + (entity.getData('fiskheroes:speed') - 1) * 0.35, 1)",
  "pitch": "1.1 - Math.random() * 0.2",
  "fadeOut": 5
}
