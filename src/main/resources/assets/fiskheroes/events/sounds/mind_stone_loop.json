{
  "sound": "fiskheroes:suit.vision.mindstone.loop",
  "condition": "entity.getData('fiskheroes:beam_shooting') > 0",
  "volume": "fiskheroes:beam_shooting_timer",
  "pitch": "1.2 - 0.1 * Math.min(entity.getInterpolatedData('fiskheroes:heat_vision_length'), 2)",
  "loop": true,
  "delay": 10,
  "fadeOut": 10
}
