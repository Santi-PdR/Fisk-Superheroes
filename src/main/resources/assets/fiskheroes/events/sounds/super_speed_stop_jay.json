{
  "parent": "fiskheroes:sound_base",
  "sound": "fiskheroes:modifier.superspeed.stop.jay",
  "condition": {
    "start": "!entity.isInWater() && !entity.getData('fiskheroes:speeding')"
  },
  "volume": "Math.min(0.0 + (entity.getData('fiskheroes:speed') - 1) * 0.35, 1)",
  "pitch": "0.7 + Math.random() * 0.3",
  "fadeOut": 5
}
