{
  "parent": "fiskheroes:sound_base",
  "sound": "fiskheroes:modifier.superspeed.negative.roar",
  "condition": {
    "start": "!entity.isInWater() && !entity.getData('fiskheroes:speeding')"
  },
  "volume": "Math.min(0.0 + (entity.getData('fiskheroes:speed') - 1) * 0.25, 0.8)",
  "pitch": "0.8 + Math.random() * 0.2",
  "fadeOut": 5
}
