{
  "parent": "fiskheroes:sound_base",
  "sound": "fiskheroes:modifier.superspeed.sprint.trajectory",
  "condition": {
    "start": "!entity.isInWater() && entity.isOnGround() && entity.getData('fiskheroes:speed') > 1 && entity.getData('fiskheroes:speed') <= 4",
    "continue": "entity.getData('fiskheroes:speeding')"
  },
  "volume": "Math.min(0.0 + (entity.getData('fiskheroes:speed') - 1) * 0.35, 1)",
  "pitch": "1.0 - Math.random() * 0.2",
  "fadeOut": 5
}
